docstring = [ fstring ] ; # A docstring is always optional, ans can use f-strings alike forrmatting

fstring =
    | TRIPLE_D_STRING_T 	@:(/(?:(?!""").)*/ )      TRIPLE_D_STRING_T
    | TRIPLE_S_STRING_T 	@:(/(?:(?!''').)*/ )      TRIPLE_S_STRING_T
    | TRIPLE_D_STRING_T 	@:(/(?:(?!""").)*/ )      TRIPLE_D_STRING_T
    | TRIPLE_S_STRING_T 	@:(/(?:(?!''').)*/ )      TRIPLE_S_STRING_T
    ;
