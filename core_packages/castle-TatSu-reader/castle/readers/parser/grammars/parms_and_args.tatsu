## .. note::  Parm vs Args
##
##    - a `Parameter` is 'placholder' definitions,
##    - an `Argument` is a value that is passed to ...
##

typedParameterTuple	=  "("  @:",".{typedParameter}*  ")" ;                       # GAM @ or @+
#typedParameter		=  modifiers:{modifiers}*   name:nameID [":" type:typeID ] ; # XXXX
typedParameter		=  name:nameID [":" type:typeID ] ;                          # XXXX

argumentTuple       =  "("   @+:",".{argument}*  ")"   ;
argument            =   [ name:nameID "=" ]  value:expression ;


modifiers		    =  OPTIONAL ;

expression =
    | literal_ID
    | lit_string
    | _ToDo_
    ;
literal_ID = ID ;
