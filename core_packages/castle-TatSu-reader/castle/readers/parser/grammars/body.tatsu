body =
    '{'
       {  @+:statement ";" }*
    '}'
    ;

statement =
    | stat_XXX
    | stat_variabledefintion
    | stat_become
    | stat_voidcall
    | stat_if
    | stat_body
    | stat_componentimplementation
    | stat__callable
    | stat__send_proto
    ;

stat_XXX =
    | 'XXX'
    | 'ToDo'
    ;
stat_variabledefintion = _ToDo_ ;
stat_become = _ToDo_ ;

stat_if = _ToDo_ ;
stat_body = _ToDo_ ;
stat_componentimplementation = _ToDo_ ;
stat__callable = _ToDo_ ;
stat__send_proto = _ToDo_ ;


stat_voidcall = longname:qualID args:argumentTuple ;
