# -*- ebnf -*-
# (C) Albert Mietus, 2026. Part of Castle/CCastle project

body =
    '{'
       {  @+:statement }*
    '}'
    ;

statement =
    | simple_statement ';'
    | complex_statement
    | compound_statement
    ;

simple_statement = # alway ends with ';' -- set above
    | stat_voidcall
    | _stat_ToDo
    # More todo
    | stat_variabledefintion
    | stat_become
    ;


complex_statement =
    # even more ...
    | stat_if
    | stat_componentimplementation
    ;

compound_statement = body ;




_stat_ToDo =
    | 'ToDo'
    | 'XXX'
    ;





stat_variabledefintion = _ToDo_ ;
stat_become = _ToDo_ ;

stat_if = _ToDo_ ;

stat_componentimplementation = _ToDo_ ;
stat__callable = _ToDo_ ;
stat__send_proto = _ToDo_ ;


stat_voidcall = longname:qualRef args:argumentTuple ;
