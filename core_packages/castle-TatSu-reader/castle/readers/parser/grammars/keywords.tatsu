# List of keywords
ALIAS               = "alias" 		;
COMPONENT           = "component"	;
DATA                = "data"		;
DEFAULT             = "default"		;
EVENT               = "event"		;
FUNCTION            = "function"	;
GLOBAL              = "global"		;
IMPLEMENT           = "implement"	;
IMPORT              = "import"		;
KIND                = "kind"		;
ON                  = "on"			;
OPTIONAL            = "optional"	;
PORT                = "port"		;
PROTOCOL            = "protocol"	;
STREAM              = "stream"		;
SUB                 = "sub"			;
_VOID               = "void"		;

# List of keywords that are more like operators
RETURNS             = "->"		    ;
REWRITER		    = "@"           ;
TRIPLE_D_STRING_T   =  '"""'        ;
TRIPLE_S_STRING_T   =  "'''"        ;
SINGLE_D_STRING_T   =  '"'          ;
SINGLE_S_STRING_T   =  "'"          ;
