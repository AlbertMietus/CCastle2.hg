# -*- ebnf -*-
# (C) Albert Mietus, 2025, 2026- Part of Castle/CCastle project

component_definition =
    COMPONENT name:nameID [parameters:typedParameterTuple] [':' base:nameID]
    docstring:docstring
    '{'
 	    { ports+:port_line ';' }*
   '}'
    ;

port_line = PORT name:nameID ':' type:proto_or_typeID      direction:port_direction  ;

port_direction = '<' direction:direction '>' ;
direction  =
    | 'in'
    | 'out'
    | 'bidirect'
    | 'master'
    | 'slave'
    ;

##Note: the '{' ...'}' in a component implementation is NOT a aigr.Body
implement_component =
    [rewriter:rewriter]
	IMPLEMENT name:nameID [parameters:typedParameterTuple] '{' # XXX parameters or arguments -- I think the last ...
    docstring:docstring
	{
        | members+:member
        | handlers+:handler
        | local_functions+:local_function
    }*
   '}'
    ;


handler =
    | event_handler
    | data_handler
    | local_function
    ;

event_handler =
    event:handlerID parameters:typedParameterTuple ON port:portID [ RETURNS returns:typeID ]
    docstring:docstring
    body:body
    ;

local_function	=
    | method
    |  _ToDo_ ; # or method/comp_function/

method =
    name:ID parameters:typedParameterTuple [ RETURNS returns:typeID ]
    docstring:docstring
    body:body
    ;





proto_or_typeID = typeID  ;
handlerID       = qualRef ;
portID          = qualRef ;











member			= _ToDo_ ;
data_handler	= _ToDo_ ;

