component_interface = 'TODO' ; # """component name: base { <ports> }"""

implement_component =
	IMPLEMENT name:nameID [parameters:parameterTuple] '{'
	{
    | members
    | handler
    | local_function
    }*
   '}'
    ;


handler =
    | event_handler
    | data_handler
    | local_function
    ;

event_handler	= event:handlerID parameters:parameterTuple ON port:portID body:body ;
handlerID       = qualID ;
portID          = qualID ;

body =
   '{'
        [_ToDo_]
   '}'
    ;








local_function	= _ToDo_ ; # or method/comp_function/

members 		= _ToDo_ ;
data_handler	= _ToDo_ ;
_ToDo_ 			= 'ToDo' ; # XXX
