component_interface =
    COMPONENT name:nameID [parameters:typedParameterTuple] [':' base:nameID] '{'
 	    { ports:port_line ';' }*
   '}'
    ;

port_line = PORT name:nameID ':' type:proto_or_typeID      direction:port_direction  ;

port_direction = '<' direction:direction '>' ;
direction  =
    | 'in'
    | 'out'
    | 'bidirect'
    | 'master'
    | 'slave'
    ;

implement_component =
	IMPLEMENT name:nameID [parameters:typedParameterTuple] '{' # XXX parameters or arguments -- I think the last ...
	{
        | members
        | handler
        | local_function
    }*
   '}'
    ;


handler =
    | event_handler
    | data_handler
    | local_function
    ;

event_handler	= event:handlerID parameters:typedParameterTuple ON port:portID body:body ;

proto_or_typeID = typeID ;
handlerID       = qualID ;
portID          = qualID ;

body =
   '{'
        [_ToDo_]
   '}'
    ;









local_function	= _ToDo_ ; # or method/comp_function/
members 		= _ToDo_ ;
data_handler	= _ToDo_ ;

