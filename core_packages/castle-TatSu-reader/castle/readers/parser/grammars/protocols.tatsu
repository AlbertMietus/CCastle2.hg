protocol_definition =
    | event_protocol
    | _ToDo_
    ;

event_protocol =
	PROTOCOL name:nameID
    '{'
		events:{ event_definition }*
    '}'
	;

event_definition =
	[ EVENT ] name:nameID parameters:typedParameterTuple [ RETURNS type:typeID ] ';'
    ;
