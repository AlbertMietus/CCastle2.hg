"""A credible version of HelloWorld. -- a bit more realistic than 'elemental'
   This variant has two connected components."""

protocol SetLabel : EventProtocol {
         set(label:str);
}

component Credible {
  port SetLabel<in>: hello;
}

implement Credible {

HelloWorld(str:label) {
   print("Hello {label} World");
}

SetLabel.set(label) on .hello {
  HelloWorld(label);
}

} //@end Credible_HelloWorld


component Credible_HelloWorld: Main {
   sub credible;


implement Credible_HelloWorld
{

init() {
  .credible :=  Credible();
}


invoke() on self.std {
   .credible.hello.set("credible")
}

} //@end Credible_HelloWorld
