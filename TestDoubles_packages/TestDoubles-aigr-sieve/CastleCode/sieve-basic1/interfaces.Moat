"""interfaces of the "basic1" version of 'The Sieve' in Castle.
   And used as a reference the manual crafted AIGR TestDoubles in this directory.

   .. seealso::

      * http://docideas.mietus.nl/en/default/CCastle/4.Blog/1.TheSieve.html
      * :file:`./__init__.py` for a general intro
"""

component Generator : Component {
   port StartSieve<in>:controll;
   port SimpleSieve<out>:outlet;
}

component Sieve(onPrime:int) : Component {
   port SimpleSieve<in>:try;
   port SimpleSieve<out>:coprime;
}

component Finder : Component {
   port SimpleSieve<in>:newPrime;
   port SimpleSieve<out>:found;
}
